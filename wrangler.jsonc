{
  "$schema": "node_modules/wrangler/config-schema.json",
  // One origin: the built client as static assets, plus the game log API (/api/*) in worker.ts.
  // Phase 7 adds the game rooms (partyserver Durable Objects) to this Worker.
  "name": "fort-knocks",
  "main": "worker.ts",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    // the API must reach the Worker instead of the SPA fallback
    "run_worker_first": ["/api/*"]
  },
  // Every match played, for referencing games in playtest feedback (migrations/)
  "d1_databases": [{ "binding": "DB", "database_name": "fort-knocks", "database_id": "080ef6d6-e9d9-479f-a709-8e58d2b65d31" }],
  "observability": { "enabled": true }
}
