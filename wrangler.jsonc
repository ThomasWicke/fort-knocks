{
  "$schema": "node_modules/wrangler/config-schema.json",
  // One origin: the built client as static assets, the game log API (/api/*) and the online rooms (/parties/*).
  "name": "fort-knocks",
  "main": "worker.ts",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    // the API and the rooms must reach the Worker instead of the SPA fallback
    "run_worker_first": ["/api/*", "/parties/*"]
  },
  // Online rooms (party/room.ts): binding "Rooms" serves /parties/rooms/<code>
  "durable_objects": { "bindings": [{ "name": "Rooms", "class_name": "FortRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["FortRoom"] }],
  // Every match played, for referencing games in playtest feedback (migrations/)
  "d1_databases": [{ "binding": "DB", "database_name": "fort-knocks", "database_id": "080ef6d6-e9d9-479f-a709-8e58d2b65d31" }],
  "observability": { "enabled": true }
}
